    "defaults": {
        "mode": "sakura",
        "proseSize": 17,
        "proseFont": "'Mali', 'Sarabun', 'Noto Sans', sans-serif",
        "lineHeight": 1.7,
        "columnWidth": 640,
        "indent": 0,
        "mesIDDisplay_enabled": true,
        "timer_enabled": true,
        "message_token_count_enabled": true
