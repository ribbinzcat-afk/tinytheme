{
    "id": "otome-dialogue",
    "name": "Otome Dialogue Box",
    "description": "กล่องข้อความสไตล์ otome/visual novel — ป้ายชื่อยื่นออกจากขอบกล่อง อวาตาร์ซ้อนทับมุมกล่อง ไม่ต้องพึ่ง Visual Novel Mode หรือ sprite",
    "author": "Apricity & Claude",
    "version": "1.0.0",

    "fontImports": [
        "https://fonts.googleapis.com/css2?family=Mali:ital,wght@0,400;0,600;0,700;1,400&family=Chonburi&display=swap"
    ],
    "fonts": [],

    "fontChoices": [
        { "label": "Mali (ค่าเริ่มต้น)", "value": "'Mali', 'Sarabun', 'Noto Sans', sans-serif" },
        { "label": "Sarabun", "value": "'Sarabun', 'Noto Sans', sans-serif" },
        { "label": "Kanit", "value": "'Kanit', 'Noto Sans', sans-serif" },
        { "label": "Noto Sans Thai", "value": "'Noto Sans Thai', 'Noto Sans', sans-serif" }
    ],

    "modes": {
